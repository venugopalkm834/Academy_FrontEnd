# ===== LIVE SITE: copy this file to ".env" on the server and fill every value =====
# Generate secrets with:  openssl rand -hex 32      (use letters/numbers only in passwords: no @ : / # characters)

SITE_ADDRESS=theacademicclub.com, www.theacademicclub.com
CLIENT_URL=https://theacademicclub.com

MONGO_USER=academic
MONGO_PASSWORD=CHANGE_ME_long_random_letters_and_numbers

JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_another_64_hex_chars
# Encrypts Aadhaar numbers. 64 hex chars. KEEP A BACKUP OF THIS VALUE: if it is lost or changed, stored Aadhaar numbers cannot be decrypted.
AADHAAR_KEY=CHANGE_ME_64_hex_chars

# The first admin account (created on first start). Log in with the mobile number + this password, then change the password.
ADMIN_PHONE=9XXXXXXXXX
ADMIN_EMAIL=admin@theacademicclub.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# No demo partners on the live site
SEED_DEMO=false

# Email (verification, password reset, payment confirmations). Use your provider's SMTP details (Zoho, Gmail app password, Brevo, SES...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Academic Club <info@academicclub.com>"

# Razorpay (INR). Leave empty to offer only manual UPI / bank payments. Webhook URL: https://theacademicclub.com/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Emails via Resend (https://resend.com). Verify your sending domain there, then paste the API key (starts with re_).
# The sender and the admin-alert address can also be changed in the admin panel (Contact & Email Settings).
RESEND_API_KEY=
