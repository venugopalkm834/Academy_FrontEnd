# SITE_ADDRESS comes from .env:  theacademicclub.com, www.theacademicclub.com   (live)   or   :80   (local, plain http)
{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API, payment webhooks and public uploads go to the Node backend
	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy backend:5000
	}

	# Everything else is the Angular app (single page app: unknown paths open index.html)
	handle {
		root * /srv
		@assets path *.js *.css *.woff2 *.png *.jpg *.jpeg *.svg *.webp *.ico
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
