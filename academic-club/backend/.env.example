NODE_ENV=development
PORT=5000
# auto = use MONGO_URI if MongoDB is running, otherwise a saved embedded database. Other values: mongo | embedded | memory
DB_MODE=auto
MONGO_URI=mongodb://127.0.0.1:27017/academic_club
CLIENT_URL=http://localhost:4200
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
SMTP_HOST=
MAIL_FROM="The Academic Club <no-reply@academicclub.example>"
ADMIN_PHONE=9000000000
ADMIN_EMAIL=admin@academicclub.example
ADMIN_PASSWORD=Admin@12345
SEED_DEMO=true

# Aadhaar encryption key (64 hex chars). Generate your own for production and NEVER change it afterwards:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AADHAAR_KEY=REPLACE_WITH_64_HEX_CHARS
# Razorpay online payments (INR). Leave empty to offer only manual UPI / bank payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
